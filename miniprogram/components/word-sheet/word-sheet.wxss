.ws-mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(74,44,69,.25);z-index:79;opacity:0;pointer-events:none;transition:opacity .25s}
.ws-mask.on{opacity:1;pointer-events:auto}
.ws{position:fixed;left:0;right:0;bottom:0;z-index:80;transform:translateY(110%);transition:transform .3s cubic-bezier(.2,1.3,.4,1)}
.ws.on{transform:none}
.ws-card{border-radius:56rpx 56rpx 0 0!important;padding:44rpx 40rpx calc(60rpx + env(safe-area-inset-bottom))!important;box-shadow:0 -12rpx 0 #4a2c45!important}
.ws-wd{font-weight:800;font-size:68rpx}
.ws-ipa{color:#8b6ae0;font-size:40rpx}
.ws-m{width:140rpx;height:140rpx;flex:none}
.ws-mean{font-size:34rpx;font-weight:700;margin:20rpx 0 32rpx}
