.app{min-height:100vh;padding-bottom:calc(200rpx + env(safe-area-inset-bottom))}
.top{position:sticky;top:0;z-index:20;display:flex;gap:16rpx;align-items:center;padding:24rpx 28rpx;background:linear-gradient(180deg,rgba(255,214,232,.95),rgba(255,214,232,0))}
.top .chip{font-size:32rpx}
.hello{display:flex;gap:20rpx;align-items:center;margin:12rpx 32rpx}
.hello-m{flex:none;width:148rpx;height:148rpx}
.hello .bubble{flex:1;margin-left:16rpx}
.goal{margin:8rpx 32rpx 0;display:flex;gap:24rpx;align-items:center}
.goal .bar{flex:1;height:36rpx;border:6rpx solid var(--ink);border-radius:999rpx;background:#fff;overflow:hidden}
.goal .fill{height:100%;background:repeating-linear-gradient(-45deg,var(--pink) 0 20rpx,#ff9fc6 20rpx 40rpx);border-radius:999rpx;transition:width .6s}

.cookie{margin:28rpx 32rpx;display:flex;gap:28rpx;align-items:center}
.cookie .ic{font-size:92rpx;transition:transform .3s}
.cookie.open .ic{transform:rotate(-18deg) scale(1.1)}
.cookie-tx{flex:1}
.cookie .h4{font-weight:800;font-size:38rpx;margin-bottom:8rpx}
.cookie .p{font-size:28rpx;line-height:1.6}

.stagehead{margin:52rpx 32rpx 12rpx;padding:28rpx 32rpx;border-radius:48rpx;border:6rpx solid var(--ink);box-shadow:0 10rpx 0 var(--ink);color:#fff;position:relative;overflow:hidden}
.stagehead .h3{font-weight:800;font-size:48rpx;text-shadow:0 4rpx 0 rgba(0,0,0,.2)}
.stagehead .sen{font-weight:700;font-size:26rpx;opacity:.9}
.stagehead .ab{margin-top:16rpx;background:rgba(255,255,255,.9);color:var(--ink);border-radius:28rpx;padding:14rpx 20rpx;font-size:26rpx;font-weight:700;position:relative}
.stagehead .big{position:absolute;right:20rpx;top:8rpx;font-size:116rpx}
.path{position:relative;margin:0 32rpx}
.dot{position:absolute;width:16rpx;height:16rpx;border-radius:50%;background:#fff}
.node{position:absolute;border-radius:50%;border:7rpx solid var(--ink);box-shadow:0 10rpx 0 var(--ink);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:48rpx;color:#fff;text-shadow:0 4rpx 0 rgba(0,0,0,.25);z-index:2}
.node.lock{background:#e6dfe8!important;color:#b5a7b5;text-shadow:none;box-shadow:0 10rpx 0 #b5a7b5;border-color:#b5a7b5}
.node.boss{font-size:76rpx;border-radius:52rpx}
.node .st{position:absolute;bottom:-46rpx;left:50%;transform:translateX(-50%);font-size:28rpx;letter-spacing:-4rpx;white-space:nowrap;text-shadow:none}
.node .st .dim{opacity:.25}
.node.cur::after{content:"";position:absolute;left:-24rpx;top:-24rpx;right:-24rpx;bottom:-24rpx;border-radius:inherit;border:8rpx solid #fff;animation:ring 1.4s infinite}
.here{position:absolute;display:flex;flex-direction:column;align-items:center;pointer-events:none;z-index:3}
.here .tag{font-weight:800;background:var(--yellow);border:6rpx solid var(--ink);border-radius:28rpx;padding:4rpx 20rpx;font-size:30rpx;margin-bottom:-12rpx;position:relative;z-index:2}
.here-m{width:116rpx;height:116rpx}
.finale{margin:60rpx 32rpx 20rpx}
.finale .h3{font-weight:800;font-size:46rpx;margin:12rpx 0}

.tabs{position:fixed;left:28rpx;right:28rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));display:flex;background:#fff;border:6rpx solid var(--ink);border-radius:48rpx;box-shadow:0 10rpx 0 var(--ink);z-index:30;padding:10rpx}
.tb{flex:1;padding:12rpx 0;border-radius:36rpx;font-weight:800;font-size:28rpx;display:flex;flex-direction:column;align-items:center}
.tb .ti{font-size:42rpx}
.tb.on{background:#ffe1ee}

.sec{margin:36rpx 32rpx}
.h2{font-weight:800;font-size:48rpx;margin:0 0 20rpx;line-height:1.35}
.postcard{display:flex;gap:24rpx;align-items:flex-start;margin-bottom:24rpx}
.postcard .em{font-size:64rpx;flex:none;width:104rpx;height:104rpx;border-radius:32rpx;background:#fff;border:6rpx solid var(--ink);display:flex;align-items:center;justify-content:center}
.postcard .pt{font-size:32rpx;font-weight:800;margin-bottom:4rpx}
.postcard .pd{font-size:28rpx;color:var(--ink2);line-height:1.55}
.lockv{position:absolute;left:0;top:0;right:0;bottom:0;background:rgba(255,255,255,.7);display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;font-size:40rpx;text-align:center;gap:12rpx;padding:0 40rpx}
.badges{display:flex;flex-wrap:wrap;gap:20rpx}
.badge{width:calc((100% - 40rpx) / 3);text-align:center;padding:24rpx 12rpx!important}
.badge .be{font-size:72rpx}
.badge .bt{font-size:28rpx;font-weight:800;margin-top:8rpx}
.badge.off{filter:grayscale(1);opacity:.45}

.ov{position:fixed;left:0;top:0;right:0;bottom:0;z-index:50;background:linear-gradient(180deg,#ffe1ee,#fff6ea 50%,#e9f7ff)}
.ov-in{height:100%}
.ov-pad{padding:24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom))}
