/* 口语糖果岛 · 全局样式（粗描边 + 马卡龙色 + 贴纸按钮）*/
page{
  --ink:#4a2c45;--ink2:#7a5d77;--cream:#fffaf3;--pink:#ff7eb3;--pink-d:#e0558f;--peach:#ffb38a;
  --lilac:#b99bff;--lilac-d:#8b6ae0;--mint:#6fd8a0;--mint-d:#3fb878;--sky:#7fd0ff;--yellow:#ffd54f;--red:#ff6b6b;
  color:var(--ink);
  font-family:-apple-system,"PingFang SC","Helvetica Neue","Microsoft YaHei",sans-serif;
  background:linear-gradient(180deg,#ffd6e8 0%,#ffe9d6 40%,#e8f6ff 100%);
  min-height:100%;
}
view,text,image,input{box-sizing:border-box}
.disp{font-weight:800;letter-spacing:2rpx}
.small{font-size:26rpx;color:var(--ink2)}
.center{text-align:center}
.row{display:flex;gap:20rpx;align-items:center;flex-wrap:wrap}

/* 贴纸按钮 */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:12rpx;font-weight:800;font-size:38rpx;padding:24rpx 40rpx;border-radius:40rpx;background:#fff;border:6rpx solid var(--ink);box-shadow:0 10rpx 0 var(--ink);color:var(--ink);line-height:1.2;transition:transform .08s,box-shadow .08s}
.press{transform:translateY(8rpx)!important;box-shadow:0 2rpx 0 var(--ink)!important}
.btn.pink{background:linear-gradient(180deg,#ff9fc6,var(--pink));color:#fff;text-shadow:0 4rpx 0 var(--pink-d)}
.btn.mint{background:linear-gradient(180deg,#9ff0c4,var(--mint));color:#fff;text-shadow:0 4rpx 0 var(--mint-d)}
.btn.lilac{background:linear-gradient(180deg,#d6c4ff,var(--lilac));color:#fff;text-shadow:0 4rpx 0 var(--lilac-d)}
.btn.yellow{background:linear-gradient(180deg,#ffe58a,var(--yellow))}
.btn.wide{display:flex;width:100%}
.btn.sm{font-size:28rpx;padding:14rpx 26rpx;border-radius:30rpx}
.btn.off{opacity:.5}
.card{background:var(--cream);border:6rpx solid var(--ink);border-radius:52rpx;box-shadow:0 12rpx 0 var(--ink);padding:36rpx}
.chip{display:inline-flex;align-items:center;gap:10rpx;background:#fff;border:5rpx solid var(--ink);border-radius:999rpx;padding:8rpx 24rpx;font-weight:800;font-size:30rpx}

/* 气泡 + 糖豆 */
.bubble{position:relative;background:#fff;border:6rpx solid var(--ink);border-radius:40rpx;padding:20rpx 28rpx;font-size:30rpx;line-height:1.5;font-weight:600}
.bubble::before{content:"";position:absolute;left:-24rpx;top:40rpx;border:18rpx solid transparent;border-right-color:var(--ink);border-left-width:0}
.bubble::after{content:"";position:absolute;left:-14rpx;top:44rpx;border:14rpx solid transparent;border-right-color:#fff;border-left-width:0}
.mascot{display:block}

/* 动画 */
@keyframes squish{30%{transform:scale(1.12,.86)}60%{transform:scale(.94,1.06)}}
@keyframes bob{50%{transform:translateY(-12rpx)}}
@keyframes pop{0%{transform:scale(.3);opacity:0}70%{transform:scale(1.12)}100%{transform:scale(1);opacity:1}}
@keyframes shake{20%,60%{transform:translateX(-16rpx)}40%,80%{transform:translateX(16rpx)}}
@keyframes boom{40%{transform:scale(1.35) rotate(8deg)}100%{transform:scale(0);opacity:0}}
@keyframes ring{0%{transform:scale(.8);opacity:1}100%{transform:scale(1.35);opacity:0}}
.shake{animation:shake .4s}
.bob{animation:bob 1.6s ease-in-out infinite}
.pop{animation:pop .35s}

/* 糖果色 */
.c0{background:#ffc2da}.c1{background:#ffd9a8}.c2{background:#bfe6ff}.c3{background:#c8f2d8}.c4{background:#e1d3ff}.c5{background:#fff0a8}

/* 可点单词 */
.en{font-weight:800;font-size:60rpx;line-height:1.3;word-break:break-word}
.en.long{font-size:48rpx}
.zh{font-size:34rpx;font-weight:600;color:var(--ink2);margin-top:12rpx}
.w{border-radius:12rpx;padding:0 4rpx}
.w.g{border-bottom:6rpx dotted var(--lilac)}
.w.ok{color:#1fa463;background:#dcf8e8}
.w.miss{color:#e5484d;background:#ffe3e3;text-decoration:underline wavy rgba(229,72,77,.35)}

/* 名字输入 */
.name{width:100%;height:96rpx;font-size:36rpx;padding:0 28rpx;border-radius:32rpx;border:6rpx solid var(--ink);background:#fff;color:var(--ink)}

/* 闯关 / 毕业 通用 */
.lhead{display:flex;align-items:center;gap:20rpx}
.lhead .x{flex:none;font-size:40rpx;width:80rpx;height:80rpx;border-radius:50%;background:#fff;border:6rpx solid var(--ink);display:flex;align-items:center;justify-content:center;font-weight:800}
.pbar{flex:1;height:40rpx;border:6rpx solid var(--ink);border-radius:999rpx;background:#fff;overflow:hidden}
.pbar .in{height:100%;background:repeating-linear-gradient(-45deg,var(--mint) 0 20rpx,#9ff0c4 20rpx 40rpx);transition:width .4s}
.combo{font-weight:800;background:var(--yellow);border:6rpx solid var(--ink);border-radius:28rpx;padding:4rpx 20rpx;font-size:30rpx;animation:pop .35s}
.coach{display:flex;align-items:flex-start;gap:12rpx;margin:28rpx 0 20rpx}
.coach .m{flex:none;width:152rpx;height:152rpx}
.coach .bubble{flex:1;margin-left:20rpx;font-size:32rpx}
.mic{width:192rpx;height:192rpx;border-radius:50%;font-size:80rpx;padding:0;margin:0 auto;position:relative}
.mic.rec{background:linear-gradient(180deg,#ff9b9b,var(--red))}
.mic.rec::after{content:"";position:absolute;left:-20rpx;top:-20rpx;right:-20rpx;bottom:-20rpx;border-radius:50%;border:8rpx solid var(--red);animation:ring 1.1s infinite}
.miclabel{text-align:center;font-weight:800;font-size:32rpx;margin-top:12rpx}
.foot{margin-top:28rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}
.fb{border-radius:44rpx;padding:28rpx 32rpx;border:6rpx solid var(--ink);margin-bottom:24rpx;animation:pop .3s}
.fb.ok{background:#dcf8e8}
.fb.no{background:#fff1d6}
.fb .t{font-weight:800;font-size:42rpx;display:block}
.fb .e{font-weight:800;font-size:36rpx;margin-top:8rpx}
.fb .d{margin-top:8rpx;font-size:30rpx}
.scorebox{display:flex;align-items:center;gap:28rpx;animation:pop .4s;margin-bottom:24rpx}
.scorebox .num{font-weight:800;font-size:92rpx;line-height:1;color:var(--pink-d)}
.scorebox .t{font-weight:800;font-size:46rpx}
.stars{font-size:48rpx;letter-spacing:4rpx}
.stars text{display:inline-block;animation:pop .5s backwards}
.stars .off{filter:grayscale(1);opacity:.3}
.praise{position:fixed;left:0;right:0;top:34%;z-index:90;text-align:center;font-weight:900;font-size:88rpx;color:#fff;text-shadow:0 8rpx 0 var(--pink-d),6rpx 6rpx 0 var(--pink-d),-6rpx 6rpx 0 var(--pink-d);pointer-events:none;animation:praise 1.2s forwards;white-space:nowrap}
@keyframes praise{0%{transform:scale(.2);opacity:0}25%{transform:scale(1.15);opacity:1}70%{transform:translateY(-40rpx) scale(1)}100%{transform:translateY(-160rpx);opacity:0}}
.stamps{display:flex;gap:16rpx;justify-content:space-between}
.stamp{width:112rpx;height:112rpx;border-radius:50%;border:6rpx dashed #c9b8c9;display:flex;align-items:center;justify-content:center;font-size:56rpx;filter:grayscale(1);opacity:.45}
.stamp.on{border:6rpx solid var(--pink-d);filter:none;opacity:1;background:#fff;transform:rotate(-8deg);box-shadow:0 0 0 8rpx #ffd1e4}
.stats{display:flex;text-align:center}
.stats > view{flex:1}
.stats .b{display:block;font-size:56rpx;font-weight:800;color:var(--pink-d)}
.coverwrap{position:relative;border-radius:44rpx;overflow:hidden;border:6rpx solid var(--ink);box-shadow:0 12rpx 0 var(--ink)}
.cover-cv{display:block;width:100%;height:898rpx}
